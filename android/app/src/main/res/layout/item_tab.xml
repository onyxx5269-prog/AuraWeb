<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_tab_item"
    android:foreground="@drawable/bg_ripple"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="4dp">

    <TextView
        android:id="@+id/letter"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_card"
        android:gravity="center"
        android:textColor="?attr/auraAccent"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?attr/auraText"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?attr/auraTextDim"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/close"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_ripple_round"
        android:contentDescription="@string/close"
        android:padding="12dp"
        android:src="@drawable/ic_close"
        android:tint="?attr/auraTextDim" />
</LinearLayout>
