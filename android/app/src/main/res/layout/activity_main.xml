<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/auraBg"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/webContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <View
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="2.5dp"
                android:alpha="0"
                android:background="@drawable/bg_progress"
                android:elevation="2dp"
                android:transformPivotX="0dp"
                android:scaleX="0" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="?attr/auraSurface"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:id="@+id/addressPill"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="4dp">

                <ImageView
                    android:id="@+id/siteIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    android:tint="?attr/auraTextDim" />

                <EditText
                    android:id="@+id/address"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/address_hint"
                    android:imeOptions="actionGo|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:paddingStart="10dp"
                    android:paddingEnd="4dp"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:textColor="?attr/auraText"
                    android:textColorHighlight="?attr/auraRipple"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/actionBtn"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_ripple_round"
                    android:contentDescription="@string/reload"
                    android:padding="9dp"
                    android:src="@drawable/ic_reload"
                    android:tint="?attr/auraTextDim" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/tabsBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_ripple_round"
                android:contentDescription="@string/tabs">

                <TextView
                    android:id="@+id/tabCount"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_tab_count"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="?attr/auraText"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <ImageView
                android:id="@+id/menuBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_ripple_round"
                android:contentDescription="@string/menu"
                android:padding="12dp"
                android:src="@drawable/ic_more"
                android:tint="?attr/auraText" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/auraScrim"
        android:visibility="gone" />

    <!-- Menu sheet -->
    <LinearLayout
        android:id="@+id/menuSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_sheet"
        android:clickable="true"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_handle" />

        <LinearLayout
            android:id="@+id/quickRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="14dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:id="@+id/menuList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- Tabs sheet -->
    <LinearLayout
        android:id="@+id/tabsSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_sheet"
        android:clickable="true"
        android:elevation="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tabs"
                android:textColor="?attr/auraText"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/newTabBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_ripple_round"
                android:contentDescription="@string/new_tab"
                android:padding="10dp"
                android:src="@drawable/ic_add"
                android:tint="?attr/auraAccent" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/tabsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tabsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
